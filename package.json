{
  "name": "farya-chef-console",
  "version": "1.0.0",
  "private": true,
  "description": "سامانهٔ بهای تمام‌شده و قیمت‌گذاری منو برای سرآشپزِ رستوران فریا (FARYA)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "fonts": "node scripts/prepare-fonts.mjs",
    "menu:qr": "node scripts/generate-menu-qr.mjs",
    "typecheck": "tsc --noEmit",
    "db:sql": "node scripts/build-all-in-one.mjs",
    "db:test": "node scripts/test-sql-like-supabase.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "pg": "^8.13.1",
    "playwright": "^1.49.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
